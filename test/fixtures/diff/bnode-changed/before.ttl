@prefix : <http://example.org/zoo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Lion a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :eats ; owl:someValuesFrom :Meat ] ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :livesIn ; owl:allValuesFrom [ owl:unionOf ( :Savanna :Zoo ) ] ] .
