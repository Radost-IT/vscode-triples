<?xml version="1.0"?>
<!-- The same ontology as pizza.ttl, in OWL/XML. -->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://example.org/pizza"
     ontologyIRI="http://example.org/pizza">
    <Prefix name="" IRI="http://example.org/pizza#"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <Literal xml:lang="en">Pizza ontology</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal>1.0</Literal>
    </Annotation>
    <Declaration><Class IRI="#Food"/></Declaration>
    <Declaration><Class IRI="#Pizza"/></Declaration>
    <Declaration><Class IRI="#PizzaBase"/></Declaration>
    <Declaration><Class IRI="#Topping"/></Declaration>
    <Declaration><Class IRI="#CheeseTopping"/></Declaration>
    <Declaration><Class IRI="#VegetableTopping"/></Declaration>
    <Declaration><Class IRI="#VegetarianPizza"/></Declaration>
    <Declaration><Class IRI="#Margherita"/></Declaration>
    <Declaration><Class abbreviatedIRI=":NamedPizza"/></Declaration>
    <Declaration><ObjectProperty IRI="#hasTopping"/></Declaration>
    <Declaration><ObjectProperty IRI="#hasBase"/></Declaration>
    <Declaration><ObjectProperty IRI="#hasIngredient"/></Declaration>
    <Declaration><DataProperty IRI="#calories"/></Declaration>
    <Declaration><AnnotationProperty IRI="#origin"/></Declaration>
    <Declaration><NamedIndividual IRI="#myMargherita"/></Declaration>

    <SubClassOf><Class IRI="#Food"/><Class abbreviatedIRI="owl:Thing"/></SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Food</IRI>
        <Literal xml:lang="en">Food</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>:Food</AbbreviatedIRI>
        <Literal xml:lang="de">Essen</Literal>
    </AnnotationAssertion>

    <SubClassOf><Class IRI="#Pizza"/><Class IRI="#Food"/></SubClassOf>
    <SubClassOf>
        <Class IRI="#Pizza"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#hasBase"/>
            <Class IRI="#PizzaBase"/>
        </ObjectSomeValuesFrom>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Pizza</IRI>
        <Literal xml:lang="en">Pizza</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Pizza</IRI>
        <Literal xml:lang="en">A dish of Italian origin.</Literal>
    </AnnotationAssertion>

    <SubClassOf><Class IRI="#PizzaBase"/><Class IRI="#Food"/></SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#PizzaBase</IRI>
        <Literal xml:lang="en">Pizza base</Literal>
    </AnnotationAssertion>
    <SubClassOf><Class IRI="#Topping"/><Class IRI="#Food"/></SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Topping</IRI>
        <Literal xml:lang="en">Topping</Literal>
    </AnnotationAssertion>
    <SubClassOf><Class IRI="#CheeseTopping"/><Class IRI="#Topping"/></SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#CheeseTopping</IRI>
        <Literal xml:lang="en">Cheese topping</Literal>
    </AnnotationAssertion>
    <SubClassOf><Class IRI="#VegetableTopping"/><Class IRI="#Topping"/></SubClassOf>
    <DisjointClasses><Class IRI="#VegetableTopping"/><Class IRI="#CheeseTopping"/></DisjointClasses>

    <EquivalentClasses>
        <Class IRI="#VegetarianPizza"/>
        <ObjectIntersectionOf>
            <Class IRI="#Pizza"/>
            <ObjectAllValuesFrom>
                <ObjectProperty IRI="#hasTopping"/>
                <ObjectUnionOf>
                    <Class IRI="#CheeseTopping"/>
                    <Class IRI="#VegetableTopping"/>
                </ObjectUnionOf>
            </ObjectAllValuesFrom>
        </ObjectIntersectionOf>
    </EquivalentClasses>

    <SubClassOf><Class IRI="#Margherita"/><Class IRI="#VegetarianPizza"/></SubClassOf>
    <SubClassOf><Class IRI="#Margherita"/><Class IRI="#NamedPizza"/></SubClassOf>
    <SubClassOf><Class IRI="#NamedPizza"/><Class IRI="#Pizza"/></SubClassOf>

    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#hasTopping</IRI>
        <Literal xml:lang="en">has topping</Literal>
    </AnnotationAssertion>
    <ObjectPropertyDomain><ObjectProperty IRI="#hasTopping"/><Class IRI="#Pizza"/></ObjectPropertyDomain>
    <ObjectPropertyRange><ObjectProperty IRI="#hasTopping"/><Class IRI="#Topping"/></ObjectPropertyRange>
    <FunctionalObjectProperty><ObjectProperty IRI="#hasBase"/></FunctionalObjectProperty>
    <SubObjectPropertyOf><ObjectProperty IRI="#hasBase"/><ObjectProperty IRI="#hasIngredient"/></SubObjectPropertyOf>
    <ObjectPropertyDomain><ObjectProperty IRI="#hasBase"/><Class IRI="#Pizza"/></ObjectPropertyDomain>
    <ObjectPropertyRange><ObjectProperty IRI="#hasBase"/><Class IRI="#PizzaBase"/></ObjectPropertyRange>
    <DataPropertyDomain><DataProperty IRI="#calories"/><Class IRI="#Food"/></DataPropertyDomain>
    <DataPropertyRange><DataProperty IRI="#calories"/><Datatype abbreviatedIRI="xsd:integer"/></DataPropertyRange>

    <ClassAssertion><Class IRI="#Margherita"/><NamedIndividual IRI="#myMargherita"/></ClassAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#myMargherita</IRI>
        <Literal xml:lang="en">My Margherita</Literal>
    </AnnotationAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#calories"/>
        <NamedIndividual IRI="#myMargherita"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">850</Literal>
    </DataPropertyAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#origin"/>
        <IRI>#myMargherita</IRI>
        <Literal>Naples</Literal>
    </AnnotationAssertion>
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#hasTopping"/>
        <NamedIndividual IRI="#myMargherita"/>
        <NamedIndividual IRI="#mozzarella"/>
    </ObjectPropertyAssertion>
    <ClassAssertion><Class IRI="#CheeseTopping"/><NamedIndividual IRI="#mozzarella"/></ClassAssertion>
</Ontology>
