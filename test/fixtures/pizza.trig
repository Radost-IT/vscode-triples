@prefix pz: <http://example.org/pizza#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.

<http://example.org/pizza> a owl:Ontology;
    <http://www.w3.org/2000/01/rdf-schema#label> "Pizza ontology"@en;
    owl:versionInfo "1.0".
pz:Food a owl:Class;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> owl:Thing;
    <http://www.w3.org/2000/01/rdf-schema#label> "Food"@en, "Essen"@de.
pz:Pizza a owl:Class;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> pz:Food.
_:n3-0 a owl:Restriction;
    owl:onProperty pz:hasBase;
    owl:someValuesFrom pz:PizzaBase.
pz:Pizza <http://www.w3.org/2000/01/rdf-schema#subClassOf> _:n3-0;
    <http://www.w3.org/2000/01/rdf-schema#label> "Pizza"@en;
    <http://www.w3.org/2000/01/rdf-schema#comment> "A dish of Italian origin."@en.
pz:PizzaBase a owl:Class;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> pz:Food;
    <http://www.w3.org/2000/01/rdf-schema#label> "Pizza base"@en.
pz:Topping a owl:Class;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> pz:Food;
    <http://www.w3.org/2000/01/rdf-schema#label> "Topping"@en.
pz:CheeseTopping a owl:Class;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> pz:Topping;
    <http://www.w3.org/2000/01/rdf-schema#label> "Cheese topping"@en.
pz:VegetableTopping a owl:Class;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> pz:Topping;
    owl:disjointWith pz:CheeseTopping.
pz:VegetarianPizza a owl:Class.
_:n3-1 a owl:Class.
_:n3-2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> pz:Pizza;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:n3-3.
_:n3-3 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> _:n3-4.
_:n3-4 a owl:Restriction;
    owl:onProperty pz:hasTopping.
_:n3-5 a owl:Class.
_:n3-6 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> pz:CheeseTopping;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:n3-7.
_:n3-7 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> pz:VegetableTopping;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil>.
_:n3-5 owl:unionOf _:n3-6.
_:n3-4 owl:allValuesFrom _:n3-5.
_:n3-3 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil>.
_:n3-1 owl:intersectionOf _:n3-2.
pz:VegetarianPizza owl:equivalentClass _:n3-1.
pz:Margherita a owl:Class;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> pz:VegetarianPizza, pz:NamedPizza.
pz:NamedPizza a owl:Class;
    <http://www.w3.org/2000/01/rdf-schema#subClassOf> pz:Pizza.
pz:hasTopping a owl:ObjectProperty;
    <http://www.w3.org/2000/01/rdf-schema#label> "has topping"@en;
    <http://www.w3.org/2000/01/rdf-schema#domain> pz:Pizza;
    <http://www.w3.org/2000/01/rdf-schema#range> pz:Topping.
pz:hasBase a owl:ObjectProperty, owl:FunctionalProperty;
    <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> pz:hasIngredient;
    <http://www.w3.org/2000/01/rdf-schema#domain> pz:Pizza;
    <http://www.w3.org/2000/01/rdf-schema#range> pz:PizzaBase.
pz:hasIngredient a owl:ObjectProperty.
pz:calories a owl:DatatypeProperty;
    <http://www.w3.org/2000/01/rdf-schema#domain> pz:Food;
    <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#integer>.
pz:origin a owl:AnnotationProperty.
pz:myMargherita a owl:NamedIndividual, pz:Margherita;
    <http://www.w3.org/2000/01/rdf-schema#label> "My Margherita"@en;
    pz:calories 850;
    pz:origin "Naples";
    pz:hasTopping pz:mozzarella.
pz:mozzarella a pz:CheeseTopping.
